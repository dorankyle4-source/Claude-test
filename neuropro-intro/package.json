{
  "name": "neuropro-intro",
  "version": "0.1.0",
  "private": true,
  "description": "NeuroPro animated series \u2014 10-second style-test intro",
  "type": "module",
  "scripts": {
    "preview": "node scripts/serve.mjs",
    "voiceover": "python3 scripts/voiceover.py",
    "audio": "node scripts/build-audio.mjs",
    "render": "node scripts/render.mjs",
    "stills": "node scripts/stills.mjs",
    "build": "npm run audio && npm run render && npm run stills",
    "ep01:voiceover": "python3 scripts/voiceover.py --comp ep01",
    "ep01:audio": "node scripts/build-audio.mjs --comp ep01",
    "ep01:render": "node scripts/render.mjs --comp ep01",
    "ep01:captions": "node scripts/captions.mjs --comp ep01",
    "ep01:build": "npm run ep01:audio && npm run ep01:render && npm run ep01:captions",
    "ep02:voiceover": "python3 scripts/voiceover.py --comp ep02",
    "ep02:audio": "node scripts/build-audio.mjs --comp ep02",
    "ep02:render": "node scripts/render.mjs --comp ep02",
    "ep02:captions": "node scripts/captions.mjs --comp ep02",
    "ep02:build": "npm run ep02:audio && npm run ep02:render && npm run ep02:captions"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@fontsource/manrope": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "playwright": "1.56.1"
  }
}
