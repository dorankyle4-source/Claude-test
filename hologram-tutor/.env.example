# Copy this file to .env and fill in your own values. .env is git-ignored.
# Never paste real keys into chat, code, or commits.

# Which AI backend to use: "anthropic" (real Claude) or "mock" (offline, no key needed).
AI_PROVIDER=anthropic

# Your Anthropic API key, from https://platform.claude.com/ -> API Keys.
ANTHROPIC_API_KEY=

# Optional: model and reasoning effort (low | medium | high | xhigh | max).
# Lower effort answers faster and costs less; higher effort reasons more carefully.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# Optional: local port (the app only listens on this computer).
PORT=3000
